{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "formatter": {
    "biome": {
      "disabled": true
    },
    "prettier": {
      "disabled": true
    }
  },
  "mcp": {
    "railway": {
      "command": [
        "railway",
        "mcp"
      ],
      "enabled": true,
      "type": "local"
    }
  },
  "model": "openai/gpt-5.4",
  "permission": {
    "edit": {
      "/tmp/**": "allow"
    },
    "external_directory": {
      "/**": "allow"
    },
    "read": {
      "/**": "allow"
    }
  },
  "plugin": [
    "@mohak34/opencode-notifier@0.1.34",
    "oh-my-opencode-slim@1.1.1",
    "btw-opencode@0.0.1"
  ],
  "provider": {
    "openrouter": {
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}",
        "baseURL": "https://openrouter.ai/api/v1"
      }
    }
  },
  "theme": "catppuccin"
}